# Talaria bridge settings.
# In the bot's macOS user, copy this to ~/.config/talaria/bridge.env and run:
#   chmod 600 ~/.config/talaria/bridge.env

# Shared secret the Hermes plugin sends as "Authorization: Bearer <token>".
# Generate one with: talaria-bridge gen-token
TALARIA_TOKEN=

# Addresses your iPhone sends from (email and/or +E.164 phone), comma-separated.
# Not sure? Run "talaria-bridge watch" and text the bot: it prints the sender.
TALARIA_ALLOWED_HANDLES=

# Address to listen on. Use this Mac's Tailscale IP (100.x.y.z) so only your
# tailnet can reach the bridge. 127.0.0.1 is fine while testing on this Mac.
TALARIA_HOST=127.0.0.1
TALARIA_PORT=8790

# Ignore messages older than this many seconds, e.g. a backlog delivered after
# the Mac wakes up (0 = no limit).
TALARIA_MAX_AGE_SECONDS=600
